// Unattended-Upgrade configuration for Debian/Ubuntu
// Managed by ansible role system-upgrade

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
    "${distro_id}:${distro_codename}-updates";
    "${distro_id}:${distro_codename}-proposed";
    "${distro_id}:${distro_codename}-backports";
};

Unattended-Upgrade::Package-Blacklist {
{% for pkg in sysupgrade_blacklisted_packages %}
    "{{ pkg }}";
{% endfor %}
};

Unattended-Upgrade::DevRelease "false";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ 'true' if sysupgrade_remove_unused_dependencies else 'false' }}";
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if sysupgrade_auto_reboot else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ sysupgrade_reboot_time }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";

{% if sysupgrade_notify_email %}
Unattended-Upgrade::Mail "{{ sysupgrade_notify_email }}";
Unattended-Upgrade::MailOnlyOnError "{{ 'true' if sysupgrade_unattended_mail_only_on_error else 'false' }}";
{% endif %}

Unattended-Upgrade::Automatic-Reboot-WithUsers "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";